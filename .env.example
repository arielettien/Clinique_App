# Copie ce fichier en ".env" (même dossier que docker-compose.yml) et remplis
# de vraies valeurs générées toi-même. Le fichier ".env" ne doit JAMAIS être
# versionné ni partagé (ajoute-le à .gitignore).
#
# Pour générer une valeur forte :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   -> SECRET_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   -> POSTGRES_PASSWORD
# Sous Windows (PowerShell), si Python n'est pas disponible :
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))

SECRET_KEY=colle_ici_une_valeur_generee_aleatoirement
POSTGRES_PASSWORD=colle_ici_une_autre_valeur_generee_aleatoirement

# Mot de passe qui chiffre les sauvegardes quotidiennes de la base (voir le
# service "backup-encrypt") — GARDE-LE PRÉCIEUSEMENT ET EN LIEU SÛR (pas
# seulement dans ce fichier) : le perdre revient à perdre l'accès à toutes
# les sauvegardes déjà chiffrées, aucune récupération possible sans lui.
BACKUP_ENCRYPTION_PASSPHRASE=colle_ici_une_troisieme_valeur_generee_aleatoirement

# Laisse à "false" tant que l'application n'est PAS servie derrière HTTPS
# (par exemple en développement local sur http://localhost:8000). Passe à
# "true" seulement une fois un vrai certificat HTTPS en place — sinon la
# connexion casse silencieusement (le navigateur refuse le cookie de session).
#
# Un certificat auto-signé local est disponible (commande
# `docker compose exec api python manage.py generate_cert <ip>`) : une fois
# généré et le service redémarré,
# l'application est servie en https:// même en local — c'est à ce moment,
# après avoir vérifié que la connexion fonctionne bien en HTTPS, qu'il faut
# passer cette valeur à "true".
COOKIE_SECURE=false

# Laisse à "true" (par défaut) pendant le développement : le serveur redémarre
# tout seul dès qu'un fichier est modifié. Passe à "false" une fois
# l'application installée durablement sur le serveur de l'ONG (le rechargement
# à chaud n'y sert à rien, et ça évite un redémarrage inopiné si un fichier
# change par accident sur la machine).
APP_RELOAD=true

# Fuseau horaire du serveur (ex: Africa/Abidjan). Utilisé pour l'horodatage
# des journaux et des sauvegardes.
TZ=UTC

# Port sur lequel l'application est joignable depuis cette machine et depuis
# le reseau local (le conteneur ecoute toujours sur 8000 en interne). Laisse
# vide ou absent pour garder 8000, le port suppose par DEPLOIEMENT.md. A
# changer uniquement si 8000 est deja pris par un autre programme sur le poste.
APP_PORT=8000

# Rechargement automatique du frontend pendant le developpement : la page se
# recharge toute seule des qu'un fichier HTML/CSS/JS change. Laisse vide pour
# suivre APP_RELOAD ci-dessus.
# ATTENTION : quand c'est actif, le Service Worker est remplace par une version
# neutralisee et le MODE HORS-LIGNE NE FONCTIONNE PAS. Mets "false" le temps de
# tester le hors-ligne, et sur le serveur de l'ONG.
FRONTEND_LIVE_RELOAD=
